<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard Connexions · Praxis</title>
<style>
:root{
  --bg:#07101f; --bg2:#0c1a2e; --card:rgba(255,255,255,.038); --bdr:rgba(255,255,255,.09);
  --txt:#e2e8f0; --txt2:#93a4b4; --sky:#38bdf8; --teal:#14b8a6; --amber:#f59e0b; --red:#ef4444; --green:#22c55e; --violet:#a78bfa;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Outfit',system-ui,sans-serif;background:linear-gradient(160deg,var(--bg) 0%,var(--bg2) 55%,var(--bg) 100%);color:var(--txt);min-height:100vh;padding-bottom:60px}
.wrap{max-width:800px;margin:0 auto;padding:0 16px}

/* Ecran de connexion */
#gate{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
.gate-card{background:var(--card);border:1px solid var(--bdr);border-radius:16px;padding:32px 24px;max-width:340px;width:100%;text-align:center}
.gate-card h1{font-size:18px;margin-bottom:6px}
.gate-card p{font-size:13px;color:var(--txt2);margin-bottom:18px}
.gate-card input{width:100%;padding:12px;border-radius:10px;border:1px solid var(--bdr);background:rgba(255,255,255,.04);color:var(--txt);font-size:15px;margin-bottom:12px;text-align:center}
.gate-card button{width:100%;padding:12px;border-radius:10px;border:none;background:var(--sky);color:#04121f;font-weight:800;font-size:14px;cursor:pointer}
.gate-error{color:var(--red);font-size:12px;margin-top:8px;min-height:16px}

#dash{display:none}
header{padding:24px 0 16px}
h1.title{font-size:22px;font-weight:800;display:flex;align-items:center;gap:8px}
.sub{color:var(--txt2);font-size:13px;margin-top:4px}

.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:18px 0}
@media(max-width:560px){.stats-grid{grid-template-columns:1fr 1fr}}
.stat-card{background:var(--card);border:1px solid var(--bdr);border-radius:14px;padding:14px;text-align:center}
.stat-v{font-size:24px;font-weight:800;color:var(--sky);display:block}
.stat-l{font-size:11px;color:var(--txt2)}

.tabs{display:flex;gap:8px;overflow-x:auto;margin-bottom:16px;padding-bottom:4px}
.tab{background:var(--card);border:1px solid var(--bdr);border-radius:20px;padding:8px 16px;font-size:13px;color:var(--txt2);cursor:pointer;white-space:nowrap;flex-shrink:0}
.tab.active{background:var(--sky);color:#04121f;font-weight:700;border-color:var(--sky)}

.conn-item{background:var(--card);border:1px solid var(--bdr);border-radius:12px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.conn-left{flex:1;min-width:0}
.conn-code{font-weight:700;font-size:14px}
.conn-detail{font-size:12px;color:var(--txt2);margin-top:2px}
.conn-right{text-align:right;flex-shrink:0}
.app-badge{display:inline-block;padding:3px 9px;border-radius:12px;font-size:10.5px;font-weight:700;margin-bottom:4px}
.app-simcare{background:rgba(56,189,248,.15);color:var(--sky)}
.app-simveto{background:rgba(34,197,94,.15);color:var(--green)}
.app-simas{background:rgba(167,139,250,.15);color:var(--violet)}
.app-praxisap{background:rgba(245,158,11,.15);color:var(--amber)}
.conn-time{font-size:11px;color:var(--txt2)}

.empty{text-align:center;color:var(--txt2);padding:40px 20px;font-size:13px}
.loading{text-align:center;color:var(--txt2);padding:40px 20px;font-size:13px}
.refresh-btn{background:none;border:1px solid var(--bdr);color:var(--txt2);padding:6px 14px;border-radius:20px;font-size:12px;cursor:pointer;margin-left:auto;display:block;margin-bottom:14px}
</style>
</head>
<body>

<div id="gate">
  <div class="gate-card">
    <h1>🔒 Dashboard Connexions</h1>
    <p>Accès formateur / administration</p>
    <input type="password" id="pw" placeholder="Mot de passe" onkeydown="if(event.key==='Enter')verifierMdp()">
    <button onclick="verifierMdp()">Accéder</button>
    <div class="gate-error" id="gate-err"></div>
  </div>
</div>

<div id="dash">
<div class="wrap">
  <header>
    <h1 class="title">📊 Dashboard Connexions</h1>
    <p class="sub">Suivi centralisé des connexions étudiants — SimCare, SimVeto, SimAs, PraxisAP</p>
  </header>

  <div class="stats-grid">
    <div class="stat-card"><span class="stat-v" id="stat-total">–</span><span class="stat-l">Connexions</span></div>
    <div class="stat-card"><span class="stat-v" id="stat-today">–</span><span class="stat-l">Aujourd'hui</span></div>
    <div class="stat-card"><span class="stat-v" id="stat-unique">–</span><span class="stat-l">Codes uniques</span></div>
    <div class="stat-card"><span class="stat-v" id="stat-apps">–</span><span class="stat-l">Applications</span></div>
  </div>

  <div class="tabs" id="tabs">
    <div class="tab active" data-app="">Toutes</div>
    <div class="tab" data-app="simcare">SimCare</div>
    <div class="tab" data-app="simveto">SimVeto</div>
    <div class="tab" data-app="simas">SimAs</div>
    <div class="tab" data-app="praxisap">PraxisAP</div>
  </div>

  <button class="refresh-btn" onclick="charger()">↻ Actualiser</button>

  <div id="liste"><div class="loading">Chargement...</div></div>
</div>
</div>

<script>
const SUPABASE_URL = 'https://fvrfiikrasezlzpaxpqz.supabase.co';
const SUPABASE_KEY = 'sb_publishable_TNksbociGaWCY53M4wCAXg_faOxEqKt';
const MDP = 'PraxisConnexions2026';

let TOUTES = [];
let filtreApp = '';

function verifierMdp(){
  const val = document.getElementById('pw').value;
  if(val === MDP){
    document.getElementById('gate').style.display = 'none';
    document.getElementById('dash').style.display = 'block';
    charger();
  } else {
    document.getElementById('gate-err').textContent = 'Mot de passe incorrect.';
  }
}

const APP_LABELS = {simcare:'SimCare', simveto:'SimVeto', simas:'SimAs', praxisap:'PraxisAP'};

function charger(){
  document.getElementById('liste').innerHTML = '<div class="loading">Chargement...</div>';
  fetch(SUPABASE_URL + '/rest/v1/connexions_historique?select=*&order=created_at.desc&limit=500', {
    headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY }
  })
  .then(r => r.json())
  .then(data => {
    TOUTES = Array.isArray(data) ? data : [];
    calculerStats();
    afficherListe();
  })
  .catch(() => {
    document.getElementById('liste').innerHTML = '<div class="empty">Erreur de chargement. Réessayez.</div>';
  });
}

function calculerStats(){
  document.getElementById('stat-total').textContent = TOUTES.length;

  const aujourdhui = new Date().toISOString().slice(0,10);
  const todayCount = TOUTES.filter(c => (c.created_at||'').slice(0,10) === aujourdhui).length;
  document.getElementById('stat-today').textContent = todayCount;

  const uniques = new Set(TOUTES.map(c => c.student_code).filter(Boolean));
  document.getElementById('stat-unique').textContent = uniques.size;

  const apps = new Set(TOUTES.map(c => c.app).filter(Boolean));
  document.getElementById('stat-apps').textContent = apps.size;
}

function afficherListe(){
  const filtered = filtreApp ? TOUTES.filter(c => c.app === filtreApp) : TOUTES;
  const container = document.getElementById('liste');

  if(filtered.length === 0){
    container.innerHTML = '<div class="empty">Aucune connexion trouvée.</div>';
    return;
  }

  container.innerHTML = filtered.slice(0, 100).map(c => {
    const appClass = 'app-' + (c.app || 'simcare');
    const appLabel = APP_LABELS[c.app] || c.app || '?';
    const date = c.created_at ? new Date(c.created_at) : null;
    const dateStr = date ? date.toLocaleString('fr-FR', {day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit'}) : '';
    const detail = [c.module, c.step].filter(Boolean).join(' · ');
    return `
      <div class="conn-item">
        <div class="conn-left">
          <div class="conn-code">${esc(c.student_code || c.student_name || '—')}</div>
          <div class="conn-detail">${esc(detail || '—')}</div>
        </div>
        <div class="conn-right">
          <div class="app-badge ${appClass}">${esc(appLabel)}</div>
          <div class="conn-time">${dateStr}</div>
        </div>
      </div>`;
  }).join('');
}

function esc(s){
  return String(s).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

document.getElementById('tabs').addEventListener('click', function(e){
  const tab = e.target.closest('.tab');
  if(!tab) return;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  tab.classList.add('active');
  filtreApp = tab.dataset.app;
  afficherListe();
});
</script>
</body>
</html>
